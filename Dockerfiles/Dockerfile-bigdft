# File role: Multi-stage BigDFT build pipeline (core/client/suite/runtime/sdk) on top of a chosen ground image.
# Build options: BASE_IMAGE, CODENAME, REPO/BIGDFT_SUITE_URL, BIGDFT_SUITE_SOURCE_MODE,
# RCFILES_DIR and CONDITIONS_* plus EXTRA_PIP_PACKAGES.
# Main stages/targets: base, upstream-core/client/suite, core-sdk, runtime-core,
# sdk

# syntax=docker/dockerfile:1

# -----------------------------------------------------------------------------
# Build arguments
#
# Core source selection
# - BASE_IMAGE: ground image to build from (required)
# - CODENAME: rcfile basename used for both:
#     - upstream file: <CODENAME>-upstream.rc
#     - compile file : <CODENAME>.rc
# - REPO: gitlab namespace for bigdft-suite
# - BIGDFT_SUITE_URL: optional explicit bigdft-suite git URL (overrides REPO)
# - BIGDFT_SUITE_BRANCH: branch/tag for bigdft-suite
# - BIGDFT_SUITE_SOURCE_MODE: how to populate BIGDFT_SUITE_SOURCES (`git` or `copy`)
# - BIGDFT_SUITE_COPY_SUBDIR: subdirectory inside the build context used in copy mode
# - BIGDFT_SUITE_SOURCES_DIR: in-image checkout path for bigdft-suite sources
# - BIGDFT_RCFILES_DIR: preferred rcfile directory, suitable for a mounted host volume
# - UPSTREAM_TARBALLS_URL: git URL for bigdft-upstream-tarballs
# - UPSTREAM_TARBALLS_BRANCH: branch containing the selected tarball profile
# - CORE_SDK_IMAGE: existing core-sdk image used by runtime-core-from-sdk
#
# Advanced stage conditions
# - CONDITIONS_CORE
# - CONDITIONS_CLIENT
# - CONDITIONS_SUITE
#
# SDK customization
# - EXTRA_PIP_PACKAGES: additional pip packages appended in sdk stage
# -----------------------------------------------------------------------------

ARG BASE_IMAGE=bigdft/ground:ubuntu-system
ARG CORE_SDK_IMAGE=bigdft/core-sdk:gnu-ubuntu24

# Keep this target before the regular stage graph.  This lets legacy Docker
# builders stop here and derive a runtime image directly from a core SDK,
# without executing any of the generic upstream dependency stages.
FROM ${CORE_SDK_IMAGE} AS runtime-core-from-sdk
RUN compile_bigdft-suite.sh
RUN install-lines /usr/local/bin/bigdft-runtime-entrypoint \
    '#!/usr/bin/env bash' \
    'set -eo pipefail' \
    'HOOK_DIR="${HOOK_DIR:-/etc/container-init.d}"' \
    'if [ -d "$HOOK_DIR" ]; then' \
    '  for f in "$HOOK_DIR"/*.sh; do' \
    '    [ -r "$f" ] || continue' \
    '    source "$f"' \
    '  done' \
    'fi' \
    'exec "$@"'
ENTRYPOINT ["/usr/local/bin/bigdft-runtime-entrypoint"]
CMD ["bash"]

FROM ${BASE_IMAGE} AS base
LABEL maintainer=bigdft-developers@lists.launchpad.net

ARG CODENAME=oneapi-hpc
ARG REPO=l_sim
ARG BIGDFT_SUITE_URL=
ARG BIGDFT_SUITE_BRANCH=devel
ARG BIGDFT_SUITE_SOURCE_MODE=git
ARG BIGDFT_SUITE_COPY_SUBDIR=.
ARG BIGDFT_SUITE_SOURCES_DIR=/opt/bigdft/sources
ARG BIGDFT_RCFILES_DIR=/opt/bigdft/rcfiles
ARG UPSTREAM_TARBALLS_URL=https://gitlab.com/l_sim/bigdft-upstream-tarballs.git
ARG UPSTREAM_TARBALLS_BRANCH=core-plugins
# Core upstream plug-ins support python, developer documentation, simulation,
# and (on a compatible oneAPI image) SYCL/DBFFT. This GNU profile deliberately
# uses Sirius instead of libxc and leaves Python/GI support to a dedicated
# compatibility-tested flavour.
# Flavour-specific builds override these defaults through build arguments.
ARG CONDITIONS_CORE_BASE=-sycl,+sirius
ARG CONDITIONS_CORE=-python,+devdoc,+simulation,-sycl,+sirius
ARG CONDITIONS_CLIENT_BASE=+ase,+vdw,+spg
ARG CONDITIONS_CLIENT=+bio,+devdoc,+boost,+amber
ARG CONDITIONS_SUITE=+sycl,+python,+devdoc,-simulation,+sirius,+ase,+vdw,+dill,+spg,+bio,+boost,+amber

RUN git config --global user.email "bigdft-project@gmail.com" && \
    git config --global user.name "BigDFT developer" && \
    git lfs install

WORKDIR /opt/bigdft

ENV BIGDFT_SUITE_SOURCES=${BIGDFT_SUITE_SOURCES_DIR}
ENV JHBUILD_RUN_AS_ROOT="please do it"
ENV BIGDFT_SUITE_TARBALLDIR=/opt/bigdft/bigdft-upstream-tarballs
ENV BIGDFT_SUITE_CHECKOUTROOT=/opt/bigdft/checkoutdir
ENV BIGDFT_RCFILES_DIR=${BIGDFT_RCFILES_DIR}
ENV BIGDFT_RCFILES_FALLBACK_DIR=${BIGDFT_SUITE_SOURCES}/rcfiles
ENV JHBUILD_COMMAND="$PYTHON $BIGDFT_SUITE_SOURCES/bundler/jhbuild.py"
ENV CODENAME=$CODENAME
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/:$LD_LIBRARY_PATH

#ENV PACKAGES_CORE_BASE="cmake-latest intellvm onemath core-upstream-suite"
ENV PACKAGES_CORE_BASE="core-upstream-suite"
ENV PACKAGES_CORE="boost fftw swig core-upstream-suite"
ENV PACKAGES_CLIENT_BASE="client-bio-baseplugins client-upstream-suite"
ENV PACKAGES_CLIENT="boost client-upstream-suite"
#ENV PACKAGES_SUITE="cmake-latest intellvm onemath boost fftw swig upstream-suite"
ENV PACKAGES_SUITE="upstream-suite"

RUN mkdir -p "$BIGDFT_SUITE_CHECKOUTROOT" "$BIGDFT_RCFILES_DIR" /etc/container-init.d /usr/local/bin

# Keep the dependency payload in a source-independent layer. The selected
# tarball profile follows the configured branch.
RUN set -eux; \
    rm -rf "$BIGDFT_SUITE_TARBALLDIR"; \
    GIT_LFS_SKIP_SMUDGE=1 git clone --depth 1 --branch "$UPSTREAM_TARBALLS_BRANCH" \
        "$UPSTREAM_TARBALLS_URL" "$BIGDFT_SUITE_TARBALLDIR"; \
    git -C "$BIGDFT_SUITE_TARBALLDIR" lfs pull; \
    git -C "$BIGDFT_SUITE_TARBALLDIR" lfs checkout; \
    rm -rf "$BIGDFT_SUITE_TARBALLDIR/.git"

RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'dest="${1:?missing destination}"' \
    'shift' \
    'mkdir -p "$(dirname "$dest")"' \
    'printf "%s\n" "$@" > "$dest"' \
    'chmod +x "$dest"' \
    > /usr/local/bin/install-lines && \
    chmod +x /usr/local/bin/install-lines

# Generic container entrypoint: source all init hooks then exec command.
RUN install-lines /usr/local/bin/container-entrypoint \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'HOOK_DIR="${HOOK_DIR:-/etc/container-init.d}"' \
    'if [ -d "$HOOK_DIR" ]; then' \
    '  for f in "$HOOK_DIR"/*.sh; do' \
    '    [ -r "$f" ] || continue' \
    '    # shellcheck disable=SC1090' \
    '    source "$f"' \
    '  done' \
    'fi' \
    'exec "$@"'

RUN install-lines /usr/local/bin/bigdft-rcfile \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'rcfile_name="${1:?missing rcfile basename}"' \
    'if [ -f "${BIGDFT_RCFILES_DIR}/${rcfile_name}" ]; then' \
    '  printf "%s\n" "${BIGDFT_RCFILES_DIR}/${rcfile_name}"' \
    'elif [ -f "${BIGDFT_RCFILES_FALLBACK_DIR}/${rcfile_name}" ]; then' \
    '  printf "%s\n" "${BIGDFT_RCFILES_FALLBACK_DIR}/${rcfile_name}"' \
    'else' \
    '  echo "Unable to resolve rcfile ${rcfile_name}" >&2' \
    '  echo "Searched: ${BIGDFT_RCFILES_DIR}/${rcfile_name}" >&2' \
    '  echo "Searched: ${BIGDFT_RCFILES_FALLBACK_DIR}/${rcfile_name}" >&2' \
    '  exit 1' \
    'fi'

RUN install-lines /usr/local/bin/bigdft-upstream \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'rcfile="$(bigdft-rcfile "${CODENAME}-upstream.rc")"' \
    'exec $PYTHON "$BIGDFT_SUITE_SOURCES/bundler/jhbuild.py" -m "$BIGDFT_SUITE_SOURCES/modulesets/upstream.modules" -f "$rcfile" "$@"'

# BigDFT runtime detection hook:
# - source the safe upstream SDK vars before the legacy runtime vars
# - derive /opt/upstream/local/pythonX.Y/dist-packages from active python
RUN install-lines /etc/container-init.d/20-bigdft-runtime.sh \
    '#!/usr/bin/env bash' \
    'if [ -f /opt/upstream/bin/bigdftvars.sh ]; then' \
    '  # shellcheck disable=SC1091' \
    '  source /opt/upstream/bin/bigdftvars.sh' \
    'fi' \
    'if [ -f /opt/bigdft/install/bin/bigdftvars.sh ]; then' \
    '  # shellcheck disable=SC1091' \
    '  source /opt/bigdft/install/bin/bigdftvars.sh || true' \
    'fi' \
    'if command -v python3 >/dev/null 2>&1; then' \
    '  py_mm="$(python3 -c "import sys; print(f\"{sys.version_info.major}.{sys.version_info.minor}\")")"' \
    '  cand="/opt/upstream/local/python${py_mm}/dist-packages"' \
    '  if [ -d "$cand" ]; then' \
    '    export PYTHONPATH="${cand}:${PYTHONPATH:-}"' \
    '    return 0' \
    '  fi' \
    'fi' \
    'for cand in /opt/upstream/local/python*/dist-packages; do' \
    '  if [ -d "$cand" ]; then' \
    '    export PYTHONPATH="${cand}:${PYTHONPATH:-}"' \
    '    break' \
    '  fi' \
    'done'

RUN install-lines /bin/compile_bigdft-suite.sh \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'rcfile="$(bigdft-rcfile "${CODENAME}.rc")"' \
    'cd /opt/bigdft' \
    '$PYTHON "$BIGDFT_SUITE_SOURCES/Installer.py" build -f "$rcfile" -y'

# The local source context is copied only after the reusable tarball layer.
# Regenerate the environment script through the bundled jhbuild.py without
# building packages; the explicit module avoids the rcfile's suite default.
COPY $BIGDFT_SUITE_COPY_SUBDIR /context

RUN set -eux; \
    rm -rf "$BIGDFT_SUITE_SOURCES"; \
    case "$BIGDFT_SUITE_SOURCE_MODE" in \
      git) \
        if [ -n "$BIGDFT_SUITE_URL" ]; then \
          suite_url="$BIGDFT_SUITE_URL"; \
        else \
          suite_url="https://gitlab.com/$REPO/bigdft-suite.git"; \
        fi; \
        git clone --depth 1 -b "$BIGDFT_SUITE_BRANCH" "$suite_url" "$BIGDFT_SUITE_SOURCES" ;; \
      copy) \
        src="/context"; \
        test -d "$src"; \
        mkdir -p "$BIGDFT_SUITE_SOURCES"; \
        cp -a "$src"/. "$BIGDFT_SUITE_SOURCES"/ ;; \
      *) \
        echo "Unsupported BIGDFT_SUITE_SOURCE_MODE=$BIGDFT_SUITE_SOURCE_MODE" >&2; \
        exit 1 ;; \
    esac; \
    rm -rf /context; \
    bigdft-upstream list core-upstream-suite >/dev/null

ENV GLIB_BUILD_DIR=/opt/bigdft/glib-2.82.5
ENV LD_LIBRARY_PATH=$GLIB_BUILD_DIR/gio:$GLIB_BUILD_DIR/glib:$GLIB_BUILD_DIR/gobject:/usr/lib/x86_64-linux-gnu/:$LD_LIBRARY_PATH

FROM base AS upstream-core-base
ARG CONDITIONS_CORE_BASE=-sycl,+sirius
RUN bigdft-upstream --conditions=$CONDITIONS_CORE_BASE build $PACKAGES_CORE_BASE && \
    bigdft-upstream --conditions=$CONDITIONS_CORE_BASE clean --skip=simtk $PACKAGES_CORE_BASE
ENV INTELPYTHON=$PYTHON

FROM upstream-core-base AS upstream-core
ARG CONDITIONS_CORE=-python,+devdoc,+simulation,-sycl,+sirius
RUN apt-get update && apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gettext libmount-dev intltool libpcre3-dev && \
    rm -rf /var/lib/apt/lists/*
RUN bigdft-upstream --conditions=$CONDITIONS_CORE build $PACKAGES_CORE && \
    bigdft-upstream --conditions=$CONDITIONS_CORE clean --skip=simtk $PACKAGES_CORE
FROM upstream-core AS core-sdk
ENV PATH=/opt/upstream/bin:/opt/upstream/local/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/upstream/lib:/opt/upstream/lib64:$LD_LIBRARY_PATH
ENV LIBRARY_PATH=/opt/upstream/lib:/opt/upstream/lib64:$LIBRARY_PATH
ENV PKG_CONFIG_PATH=/opt/upstream/lib/pkgconfig:/opt/upstream/lib64/pkgconfig:$PKG_CONFIG_PATH
ENV CMAKE_PREFIX_PATH=/opt/upstream:$CMAKE_PREFIX_PATH
ENTRYPOINT ["/usr/local/bin/container-entrypoint"]
CMD ["bash"]

FROM upstream-core AS runtime-core
RUN compile_bigdft-suite.sh
RUN install-lines /usr/local/bin/bigdft-runtime-entrypoint \
    '#!/usr/bin/env bash' \
    'set -eo pipefail' \
    'HOOK_DIR="${HOOK_DIR:-/etc/container-init.d}"' \
    'if [ -d "$HOOK_DIR" ]; then' \
    '  for f in "$HOOK_DIR"/*.sh; do' \
    '    [ -r "$f" ] || continue' \
    '    source "$f"' \
    '  done' \
    'fi' \
    'exec "$@"'
ENTRYPOINT ["/usr/local/bin/bigdft-runtime-entrypoint"]
CMD ["bash"]

FROM upstream-core-base AS runtime-core-base
RUN compile_bigdft-suite.sh
ENTRYPOINT ["/usr/local/bin/container-entrypoint"]
CMD ["bash"]

FROM base AS upstream-client-base
ARG CONDITIONS_CLIENT_BASE=+ase,+vdw,+spg
RUN bigdft-upstream --conditions=$CONDITIONS_CLIENT_BASE build $PACKAGES_CLIENT_BASE && \
    bigdft-upstream --conditions=$CONDITIONS_CLIENT_BASE clean --skip=simtk $PACKAGES_CLIENT_BASE

FROM upstream-client-base AS upstream-client
ARG CONDITIONS_CLIENT=+bio,+devdoc,+boost,+amber
RUN apt-get update && apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gettext libmount-dev intltool python3-gi libpcre3-dev python3-tk && \
    rm -rf /var/lib/apt/lists/*
RUN pip install matplotlib --break-system-packages
RUN bigdft-upstream --conditions=$CONDITIONS_CLIENT build $PACKAGES_CLIENT && \
    bigdft-upstream --conditions=$CONDITIONS_CLIENT clean --skip=simtk $PACKAGES_CLIENT

FROM base AS upstream-suite
ARG CONDITIONS_SUITE=+sycl,+python,+devdoc,-simulation,+sirius,+ase,+vdw,+dill,+spg,+bio,+boost,+amber
RUN apt-get update && apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gettext libmount-dev intltool libpcre3-dev python3-tk libfreetype-dev && \
    rm -rf /var/lib/apt/lists/*
RUN pip install matplotlib Cython scipy --break-system-packages
RUN bigdft-upstream --conditions=$CONDITIONS_SUITE build $PACKAGES_SUITE && \
    bigdft-upstream --conditions=$CONDITIONS_SUITE clean --skip=simtk $PACKAGES_SUITE

FROM upstream-suite AS sdk
ARG EXTRA_PIP_PACKAGES=
RUN apt-get update && apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gdb valgrind vim graphviz sshpass rsync && \
    rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/lib/x86_64-linux-gnu/libpthread.so.0 /usr/lib/x86_64-linux-gnu/libpthread.so
EXPOSE 8888

RUN pip install jupyterlab py3dmol xlrd openpyxl mplcursors clustergrammer_widget remotemanager \
    networkx seaborn pillow python-constraint tinydb parmed lxml pint typing-extensions \
    importlib_resources cachetools cairosvg pubchempy propka bokeh xlsxwriter \
    --break-system-packages --root-user-action ignore && \
    if [ -n "$EXTRA_PIP_PACKAGES" ]; then \
      pip install $EXTRA_PIP_PACKAGES --break-system-packages --root-user-action ignore; \
    fi

RUN install-lines /bin/run_notebook.sh \
    '#!/usr/bin/env bash' \
    'source /opt/bigdft/install/bin/bigdftvars.sh' \
    'ulimit -s unlimited' \
    'jupyter-lab --ip=0.0.0.0 --allow-root --NotebookApp.token=bigdft --no-browser'

ENTRYPOINT ["/usr/local/bin/container-entrypoint"]
CMD ["bash", "/bin/run_notebook.sh"]
