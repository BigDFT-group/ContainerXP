# File role: OpenVSCode-based IDE container on top of configurable SDK/base image.
# Build options: ARG BASE_IMAGE, OVS_VERSION, PORT.
# Main stages/targets: single stage

# syntax=docker/dockerfile:1

ARG BASE_IMAGE=bigdft/sdk:latest
FROM ${BASE_IMAGE}

ENV CONTAINER_DATE=10-03-26

# Basic tools
RUN apt-get update && apt-get install -y \
    curl \
    git \
    openssh-client \
    ca-certificates \
    nodejs \
    npm \
    python3-pip \
    tini \
    tmux \
    less \
    ripgrep \
    fd-find \
 && rm -rf /var/lib/apt/lists/*

# OpenVSCode Server
ARG OVS_VERSION=1.109.5
RUN curl -L "https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v${OVS_VERSION}/openvscode-server-v${OVS_VERSION}-linux-x64.tar.gz" \
    | tar -xz -C /opt \
 && mv /opt/openvscode-server-v${OVS_VERSION}-linux-x64 /opt/openvscode-server

# Codex CLI
RUN npm install -g @openai/codex

# Aider
RUN pip install --no-cache-dir aider-chat

# Optional GUI-related packages you already had
RUN apt-get update && apt-get install -y \
    vulkan-tools \
    mesa-vulkan-drivers \
    libvulkan1 \
    mesa-utils \
    libasound2t64 \
 && rm -rf /var/lib/apt/lists/*

# Install Zed in a system-visible location
ENV SHELL=/usr/bin/bash

RUN curl -f https://zed.dev/install.sh | sh && \
    mv /root/.local/zed.app /opt/zed.app && \
    ln -sf /opt/zed.app/bin/zed /usr/local/bin/zed

ENV XDG_RUNTIME_DIR=/tmp/xdg-runtime-ide
RUN mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

ENV PATH="/opt/openvscode-server/bin:${PATH}"
ENV OPENVSCODE_SERVER_ROOT=/opt/openvscode-server

# Standard container init hooks.
RUN mkdir -p /etc/container-init.d /usr/local/bin /etc/profile.d && \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'set -euo pipefail' \
      'HOOK_DIR="${HOOK_DIR:-/etc/container-init.d}"' \
      'if [ -d "$HOOK_DIR" ]; then' \
      '  for f in "$HOOK_DIR"/*.sh; do' \
      '    [ -r "$f" ] || continue' \
      '    # shellcheck disable=SC1090' \
      '    source "$f"' \
      '  done' \
      'fi' \
      'exec "$@"' \
      > /usr/local/bin/container-entrypoint && \
    chmod +x /usr/local/bin/container-entrypoint

## IDE hook: ensure XDG runtime dir exists with correct permissions at container start.
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'uid="$(id -u)"' \
  'export XDG_RUNTIME_DIR="/tmp/xdg-runtime-ide-${uid}"' \
  'mkdir -p "$XDG_RUNTIME_DIR"' \
  'chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true' \
  > /etc/container-init.d/80-ide-runtime.sh && \
  chmod +x /etc/container-init.d/80-ide-runtime.sh

# Helper: sanitize current directory into a tmux-friendly suffix
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'base="$(basename "${PWD}")"' \
  'base="${base//[^A-Za-z0-9_.-]/_}"' \
  'printf "%s\n" "$base"' \
  > /usr/local/bin/session-dir-name && \
  chmod +x /usr/local/bin/session-dir-name

# Reattach/create Codex tmux session
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'name="${1:-codex-$(session-dir-name)}"' \
  'shift || true' \
  'if tmux has-session -t "$name" 2>/dev/null; then' \
  '  exec tmux attach -t "$name"' \
  'else' \
  '  exec tmux new-session -s "$name" -c "$PWD" codex "$@"' \
  'fi' \
  > /usr/local/bin/codex-session && \
  chmod +x /usr/local/bin/codex-session

# Reattach/create Aider tmux session
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'name="${1:-aider-$(session-dir-name)}"' \
  'shift || true' \
  'if tmux has-session -t "$name" 2>/dev/null; then' \
  '  exec tmux attach -t "$name"' \
  'else' \
  '  exec tmux new-session -s "$name" -c "$PWD" aider "$@"' \
  'fi' \
  > /usr/local/bin/aider-session && \
  chmod +x /usr/local/bin/aider-session

# List active LLM-related tmux sessions
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'tmux list-sessions 2>/dev/null | grep -E "^(codex|aider)-" || true' \
  > /usr/local/bin/llm-sessions && \
  chmod +x /usr/local/bin/llm-sessions

# Handy aliases for interactive shells
RUN printf '%s\n' \
  'alias codexr="codex-session"' \
  'alias aiderr="aider-session"' \
  'alias llms="llm-sessions"' \
  > /etc/profile.d/llm-tools.sh


ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/container-entrypoint"]

ENV WORKSPACE_DIR=.
CMD ["sh", "-lc", "exec /opt/openvscode-server/bin/openvscode-server --host 0.0.0.0 --port 3123 --without-connection-token --workspace-folder ${WORKSPACE_DIR}"]
