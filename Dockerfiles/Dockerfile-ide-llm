# File role: OpenVSCode-based IDE container on top of configurable SDK/base image.
# Build options: ARG BASE_IMAGE, OVS_VERSION, PORT.
# Main stages/targets: single stage

# syntax=docker/dockerfile:1

ARG BASE_IMAGE=bigdft/sdk:latest
FROM ${BASE_IMAGE}

USER root

# Basic tools
RUN apt-get update && apt-get install -y \
    curl \
    git \
    openssh-client \
    ca-certificates \
    nodejs \
    npm \
    python3-pip \
    tini \
 && rm -rf /var/lib/apt/lists/*

# OpenVSCode Server
ARG OVS_VERSION=1.109.5
RUN curl -L "https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v${OVS_VERSION}/openvscode-server-v${OVS_VERSION}-linux-x64.tar.gz" \
    | tar -xz -C /opt \
 && mv /opt/openvscode-server-v${OVS_VERSION}-linux-x64 /opt/openvscode-server

# Codex CLI
RUN npm install -g @openai/codex

# Aider
RUN pip install --no-cache-dir aider-chat

# Non-root user
#RUN useradd -ms /bin/bash coder
#USER coder
#WORKDIR /workspace

RUN apt-get update && apt-get install -y \
    vulkan-tools \
    mesa-vulkan-drivers \
    libvulkan1 \
    mesa-utils \
 && rm -rf /var/lib/apt/lists/*

ENV SHELL=/usr/bin/bash
RUN curl -f https://zed.dev/install.sh | sh

ENV XDG_RUNTIME_DIR=/tmp/xdg-runtime-ide
RUN mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

ENV PATH="/opt/openvscode-server/bin:${PATH}"
ENV OPENVSCODE_SERVER_ROOT=/opt/openvscode-server

# Standard container init hooks.
# Any image can drop scripts in /etc/container-init.d/*.sh and they will be
# sourced before the main CMD is executed.
RUN mkdir -p /etc/container-init.d /usr/local/bin && \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'set -euo pipefail' \
      'HOOK_DIR="${HOOK_DIR:-/etc/container-init.d}"' \
      'if [ -d "$HOOK_DIR" ]; then' \
      '  for f in "$HOOK_DIR"/*.sh; do' \
      '    [ -r "$f" ] || continue' \
      '    # shellcheck disable=SC1090' \
      '    source "$f"' \
      '  done' \
      'fi' \
      'exec "$@"' \
      > /usr/local/bin/container-entrypoint && \
    chmod +x /usr/local/bin/container-entrypoint

# IDE hook: ensure XDG runtime dir exists with correct permissions at container start.
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg-runtime-ide}"' \
  'mkdir -p "$XDG_RUNTIME_DIR"' \
  'chmod 700 "$XDG_RUNTIME_DIR" || true' \
  > /etc/container-init.d/80-ide-runtime.sh && \
  chmod +x /etc/container-init.d/80-ide-runtime.sh

ARG PORT=3000
EXPOSE $PORT

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/container-entrypoint"]
# Use shell form via sh -lc so PORT/WORKSPACE_DIR can be overridden at runtime.
ENV WORKSPACE_DIR=.
CMD ["sh", "-lc", "exec /opt/openvscode-server/bin/openvscode-server --host 0.0.0.0 --port ${PORT} --without-connection-token --workspace-folder ${WORKSPACE_DIR}"]
